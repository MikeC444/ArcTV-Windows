<Window x:Class="ArcTV.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arc TV" Width="1280" Height="760" MinWidth="900" MinHeight="560"
        Icon="/Assets/ArcTV.ico"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen">
  <Grid>
    <ContentControl x:Name="Host" />
    <TextBlock x:Name="VersionLabel" Margin="16" FontSize="12" Foreground="{StaticResource Text3Brush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False" />
  </Grid>
</Window>
