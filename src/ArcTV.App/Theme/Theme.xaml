<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:ArcTV.App.Controls">
  <!-- The same near-black surfaces and the cyan, blue and violet of the Arc TV logo as the web, Mac and Fire TV apps. -->
  <Color x:Key="BgColor">#08080A</Color>
  <Color x:Key="BgElevatedColor">#141417</Color>
  <Color x:Key="SurfaceColor">#1C1C20</Color>
  <Color x:Key="SurfaceHighColor">#26262B</Color>
  <Color x:Key="TextColor">#F6F6F8</Color>
  <Color x:Key="Text2Color">#A9A9B4</Color>
  <Color x:Key="Text3Color">#6F6F7B</Color>
  <Color x:Key="CyanColor">#19E6FF</Color>
  <Color x:Key="BlueColor">#2F80FF</Color>
  <Color x:Key="VioletColor">#9B5CFF</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceHighBrush" Color="{StaticResource SurfaceHighColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}" />
  <SolidColorBrush x:Key="Text3Brush" Color="{StaticResource Text3Color}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource CyanColor}" />

  <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource CyanColor}" Offset="0" />
    <GradientStop Color="{StaticResource BlueColor}" Offset="0.55" />
    <GradientStop Color="{StaticResource VioletColor}" Offset="1" />
  </LinearGradientBrush>

  <!-- the logo's blue running into its purple, used for every chosen pill -->
  <LinearGradientBrush x:Key="PillGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="{StaticResource BlueColor}" Offset="0" />
    <GradientStop Color="{StaticResource VioletColor}" Offset="1" />
  </LinearGradientBrush>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Foreground" Value="#06070A" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Height" Value="46" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Box" Background="{StaticResource BrandGradient}" CornerRadius="10" Padding="22,0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.9" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.4" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GhostButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Height" Value="46" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Box" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="10" Padding="22,0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#26FFFFFF" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.4" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Label" Property="TextDecorations" Value="Underline" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style x:Key="Field" TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="#2AFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="PasswordField" TargetType="PasswordBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="#2AFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- a place in the top bar; the one you are on is brighter with the brand line under it (the button's Tag is "selected") -->
  <Style x:Key="NavPill" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Box" CornerRadius="24" Background="Transparent" Padding="26,11">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="Line" Height="2" Width="22" CornerRadius="1" Background="{StaticResource BrandGradient}" VerticalAlignment="Bottom" Margin="0,0,0,3" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#17FFFFFF" /></Trigger>
            <Trigger Property="Tag" Value="selected">
              <Setter Property="Foreground" Value="White" />
              <Setter Property="FontWeight" Value="Bold" />
              <Setter TargetName="Box" Property="Background" Value="{StaticResource PillGradient}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a pill to choose with (genre, sort); the chosen one is white (the button's Tag is "selected") -->
  <Style x:Key="ChoicePill" TargetType="Button">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Box" CornerRadius="19" MinHeight="34" Padding="18,0" Background="#5908080A" BorderBrush="#8CFFFFFF" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Background" Value="#26FFFFFF" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PillGradient}" />
            </Trigger>
            <Trigger Property="Tag" Value="selected">
              <Setter Property="FontWeight" Value="Bold" />
              <Setter TargetName="Box" Property="Background" Value="{StaticResource PillGradient}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="Transparent" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

    <!-- a row in the suggestion list; lit under the pointer and when it is the one the arrow keys are on (Tag is "selected") -->
    <Style x:Key="SuggestionRow" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" CornerRadius="10" MinHeight="44" Padding="12,8" Background="Transparent">
              <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource SurfaceHighBrush}" /></Trigger>
              <Trigger Property="Tag" Value="selected"><Setter TargetName="Box" Property="Background" Value="{StaticResource SurfaceHighBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  <!-- a poster you can click: no button chrome, just the card inside -->
  <Style x:Key="PosterButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a season number in a circle; the chosen one is white (the button's Tag is "selected") -->
  <Style x:Key="SeasonCircle" TargetType="Button">
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="52" />
    <Setter Property="Margin" Value="0,0,12,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Ellipse x:Name="Disc" Fill="#1FFFFFFF" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="Fill" Value="#33FFFFFF" /></Trigger>
            <Trigger Property="Tag" Value="selected">
              <Setter TargetName="Disc" Property="Fill" Value="{StaticResource PillGradient}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- the menus that drop down from a button (the account menu): dark, rounded, lit under the pointer -->
  <!-- an on/off switch: grey when off, the brand blue-to-purple when on, with a round knob -->
  <Style x:Key="SwitchToggle" TargetType="ToggleButton">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Track" Background="#3A3A42" CornerRadius="13">
            <Ellipse x:Name="Knob" Width="20" Height="20" Fill="#F6F6F8" HorizontalAlignment="Left" Margin="3,0,0,0" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource PillGradient}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.5" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DarkMenu" TargetType="ContextMenu">
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Padding="6" MinWidth="220">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DarkMenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Box" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Box" Property="Background" Value="#26FFFFFF" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.7" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DarkMenuSeparator" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Rectangle Height="1" Fill="#26FFFFFF" Margin="6,4" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <c:PastStartVisibility x:Key="PastStartVisibility" />
  <c:MoreToComeVisibility x:Key="MoreToComeVisibility" />

  <!-- the round arrow at the end of a row: out of sight until the pointer is over the row -->
  <Style x:Key="RowArrow" TargetType="Button">
    <Setter Property="Width" Value="60" />
    <Setter Property="Height" Value="60" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="8,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Ellipse x:Name="Disc" Fill="#CC141417" Stroke="#40FFFFFF" StrokeThickness="1" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="Fill" Value="{StaticResource PillGradient}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a row that scrolls sideways: arrows at its ends while the pointer is over it, only the ones that lead somewhere -->
  <Style x:Key="ArrowRowScroll" TargetType="ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid x:Name="Root" Background="Transparent">
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}" />
            <Button x:Name="RowLeft" Style="{StaticResource RowArrow}" HorizontalAlignment="Left" Focusable="False" Visibility="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PastStartVisibility}}">
              <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="24" />
            </Button>
            <Button x:Name="RowRight" Style="{StaticResource RowArrow}" HorizontalAlignment="Right" Focusable="False">
              <Button.Visibility>
                <MultiBinding Converter="{StaticResource MoreToComeVisibility}">
                  <Binding Path="HorizontalOffset" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="ScrollableWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                </MultiBinding>
              </Button.Visibility>
              <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="24" />
            </Button>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
              <Setter TargetName="RowLeft" Property="Opacity" Value="1" />
              <Setter TargetName="RowLeft" Property="IsHitTestVisible" Value="True" />
              <Setter TargetName="RowRight" Property="Opacity" Value="1" />
              <Setter TargetName="RowRight" Property="IsHitTestVisible" Value="True" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a row in the source list: lit under the pointer, outlined when it is the recommended one (the button's Tag is "recommended") -->
  <Style x:Key="SourceRow" TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Box" CornerRadius="14" Padding="16,12" Background="#D926262B" BorderBrush="Transparent" BorderThickness="1.5">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="recommended"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource SurfaceBrush}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.55" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- no scroll bars anywhere: pages and rows scroll with the wheel, a touchpad, the keyboard and the arrows on rows (a scroll viewer works the same with its bars out of sight) -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar"><Border Background="Transparent" /></ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="0" />
        <Setter Property="MinHeight" Value="0" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DotButton" TargetType="Button">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent"><Ellipse Width="8" Height="8" Fill="White" /></Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
