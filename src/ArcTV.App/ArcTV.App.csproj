<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows app: WPF (native Windows, not a web page in a window). Press F5 in Visual Studio to run it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ArcTV</AssemblyName>
    <RootNamespace>ArcTV.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ArcTV.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- a PC with only a newer .NET desktop runtime can still run a build made without the runtime bundled (Visual Studio's F5) -->
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <!-- the release workflow passes -p:ArcTVApiBaseUrl=... (its API_BASE_URL secret); AppInfo reads it back -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ArcTVApiBaseUrl</_Parameter1>
      <_Parameter2>$(ArcTVApiBaseUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
    <Resource Include="Assets\auth-hero.jpg" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\avatars\*.png" />
    <Resource Include="Assets\ArcTV.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ArcTV.Core\ArcTV.Core.csproj" />
  </ItemGroup>
  <!--
    The video player is mpv, used through its library, libmpv-2.dll (an LGPL build), which sits beside ArcTV.exe. It is not kept in git: scripts\get-libmpv.ps1 downloads it into the libmpv folder, and
    this target does so on the first build on Windows if it is missing (a failed download never fails the build: the player then says the engine is missing). Set -p:SkipLibMpv=true to skip it.
  -->
  <ItemGroup>
    <None Include="libmpv\libmpv-2.dll" Condition="Exists('libmpv\libmpv-2.dll')" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="GetLibMpv" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT' And '$(SkipLibMpv)' != 'true' And !Exists('$(MSBuildProjectDirectory)\libmpv\libmpv-2.dll')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\get-libmpv.ps1&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ContinueOnError="true" />
    <ItemGroup>
      <None Include="libmpv\libmpv-2.dll" Condition="Exists('libmpv\libmpv-2.dll')" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <!--
    The torrent engine libtorrent is used through ctorrent.dll (native/ctorrent) and the libraries it needs, all beside ArcTV.exe. Not kept in git: scripts\get-libtorrent.ps1 downloads them (built by
    the Build libtorrent workflow) into the libtorrent folder, and this target does so on the first build on Windows if they are missing. A failed download never fails the build: torrents then play
    with MonoTorrent, which is built into the app. Set -p:SkipLibTorrent=true to skip it.
  -->
  <ItemGroup>
    <None Include="libtorrent\*.dll" Condition="Exists('libtorrent\ctorrent.dll')" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="GetLibTorrent" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT' And '$(SkipLibTorrent)' != 'true' And !Exists('$(MSBuildProjectDirectory)\libtorrent\ctorrent.dll')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\get-libtorrent.ps1&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ContinueOnError="true" />
    <ItemGroup>
      <None Include="libtorrent\*.dll" Condition="Exists('libtorrent\ctorrent.dll')" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
