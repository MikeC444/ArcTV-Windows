<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:ArcTV.App.Controls"
                    xmlns:addons="clr-namespace:ArcTV.Core.Addons;assembly=ArcTV.Core">
    <BooleanToVisibilityConverter x:Key="WatchedVisibility" />

    <!-- one poster: the picture, and the name under it; it lifts a little under the pointer -->
    <DataTemplate DataType="{x:Type addons:MetaPreview}">
      <Button Style="{StaticResource PosterButton}">
        <StackPanel x:Name="Card" Width="288" Margin="0,10,16,10" Background="Transparent" RenderTransformOrigin="0.5,0.5" Cursor="Hand">
          <StackPanel.LayoutTransform><ScaleTransform ScaleX="{Binding Scale, Source={x:Static c:PosterMetrics.Instance}}" ScaleY="{Binding Scale, Source={x:Static c:PosterMetrics.Instance}}" /></StackPanel.LayoutTransform>
          <StackPanel.RenderTransform><ScaleTransform x:Name="Lift" ScaleX="1" ScaleY="1" /></StackPanel.RenderTransform>
          <c:RoundedBorder Width="288" Height="432" CornerRadius="16" Background="{StaticResource SurfaceBrush}" BorderBrush="#24FFFFFF" BorderThickness="1">
            <Grid>
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="12" Foreground="{StaticResource Text3Brush}" FontSize="13" />
              <c:RemoteImage Url="{Binding Poster}" DecodeWidth="600" Stretch="UniformToFill" />
              <!-- a green tick on a title that has been watched -->
              <Border Width="26" Height="26" CornerRadius="13" Background="#2ECC71" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Visibility="{Binding Watched, Converter={StaticResource WatchedVisibility}}">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </c:RoundedBorder>
          <TextBlock Text="{Binding Name}" Margin="2,8,2,0" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Button>
      <DataTemplate.Triggers>
        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.ExitActions>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
