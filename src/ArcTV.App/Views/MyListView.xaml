<UserControl x:Class="ArcTV.App.Views.MyListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ArcTV.App.Views"
             xmlns:c="clr-namespace:ArcTV.App.Controls">
  <Grid x:Name="Root">
    <!-- the heading is given to the poster list in code, as its first line, so the posters scroll all the way to the top of the window -->
    <v:PosterGrid x:Name="Posters" />
    <StackPanel x:Name="HeaderPanel">
      <TextBlock Text="My List" FontSize="34" FontWeight="ExtraBold" Margin="24,124,24,12" />

      <!-- All / Watched on the left, the sort on the right -->
      <Grid x:Name="ListControls" Margin="24,0,24,18" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <Button x:Name="AllPill" Content="All" Style="{StaticResource ChoicePill}" Margin="0,0,10,0" Click="OnAll" />
          <Button x:Name="WatchedPill" Content="Watched" Style="{StaticResource ChoicePill}" Click="OnWatched" />
        </StackPanel>
        <Button x:Name="SortButton" Style="{StaticResource ChoicePill}" HorizontalAlignment="Right" Click="OnSortButton" />
        <Popup x:Name="SortPopup" PlacementTarget="{Binding ElementName=SortButton}" Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" Closed="OnSortClosed" />
      </Grid>

<ContentControl x:Name="LoadingPanel" IsHitTestVisible="False" />

      <StackPanel x:Name="ErrorPanel" Margin="24,12,24,0" HorizontalAlignment="Left" Visibility="Collapsed">
        <TextBlock x:Name="ErrorText" FontSize="15" TextWrapping="Wrap" Foreground="{StaticResource Text2Brush}" />
        <Button Content="Try again" Style="{StaticResource GhostButton}" Width="160" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnRetry" />
      </StackPanel>

      <TextBlock x:Name="Message" Margin="24,12,24,0" FontSize="15" TextWrapping="Wrap" Foreground="{StaticResource Text2Brush}" Visibility="Collapsed" />
  </StackPanel>

  </Grid>
</UserControl>
