<UserControl x:Class="ArcTV.App.Views.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ArcTV.App.Controls">
  <Grid Background="{StaticResource BgBrush}">
    <!-- the title's artwork behind the page, darkened so the words read -->
    <Grid IsHitTestVisible="False" ClipToBounds="True">
      <c:RemoteImage x:Name="Backdrop" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Top" DecodeWidth="0" />
      <Rectangle>
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#B808080A" Offset="0" />
            <GradientStop Color="#5208080A" Offset="0.6" />
            <GradientStop Color="#6B08080A" Offset="1" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- the title: poster, year, logo, genres and length, description -->
      <ScrollViewer Grid.Column="0" x:Name="InfoScroll" VerticalScrollBarVisibility="Hidden">
        <StackPanel Margin="28,132,16,24">
          <Button Content="&#x2039;  Back" Style="{StaticResource ChoicePill}" HorizontalAlignment="Left" Click="OnBack" />
          <c:RoundedBorder Width="240" Height="360" CornerRadius="18" Margin="0,18,0,0" HorizontalAlignment="Left" Background="{StaticResource SurfaceBrush}" BorderBrush="#24FFFFFF" BorderThickness="1">
            <c:RemoteImage x:Name="PosterImage" DecodeWidth="520" Stretch="UniformToFill" />
          </c:RoundedBorder>
          <TextBlock x:Name="YearText" FontSize="18" Foreground="{StaticResource Text2Brush}" Margin="0,16,0,0" />
          <Grid HorizontalAlignment="Left" Margin="0,6,0,0">
            <TextBlock x:Name="TitleText" FontSize="34" FontWeight="ExtraBold" TextWrapping="Wrap" MaxWidth="420" />
            <c:RemoteImage x:Name="LogoImage" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxWidth="340" MaxHeight="110" DecodeWidth="680" Shown="OnLogoShown" />
          </Grid>
          <TextBlock x:Name="EpisodeText" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
          <TextBlock x:Name="FactsText" FontSize="16" Foreground="{StaticResource Text2Brush}" Margin="0,8,0,0" TextWrapping="Wrap" />
          <TextBlock x:Name="DescriptionText" FontSize="16" Foreground="{StaticResource Text2Brush}" Margin="0,12,0,0" TextWrapping="Wrap" MaxHeight="140" TextTrimming="CharacterEllipsis" />
          <Border CornerRadius="12" Background="#80000000" Padding="12" Margin="0,24,0,0">
            <StackPanel>
              <TextBlock Text="What are sources?" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="Sources are different streams or files available online. Choose the one that works best for you." FontSize="14" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- the sources -->
      <ScrollViewer Grid.Column="1" x:Name="ListScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,132,28,48">
          <TextBlock Text="Select a source" FontSize="30" FontWeight="ExtraBold" />
          <TextBlock Text="Choose the best quality and server for your stream." FontSize="15" Foreground="{StaticResource Text2Brush}" Margin="0,4,0,14" />

          <Border x:Name="NoticeBox" CornerRadius="10" Padding="12" Margin="0,0,0,14" Background="#1F19E6FF" Visibility="Collapsed">
            <TextBlock x:Name="NoticeText" FontSize="14" TextWrapping="Wrap" />
          </Border>

          <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Left" Margin="0,6,0,0">
            <TextBlock x:Name="LoadingText" Text="Asking your addons…" FontSize="16" Foreground="{StaticResource Text2Brush}" />
            <ProgressBar IsIndeterminate="True" Height="3" Width="220" Margin="0,14,0,0" HorizontalAlignment="Left" Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceBrush}" BorderThickness="0" />
          </StackPanel>

          <StackPanel x:Name="ListPanel" Visibility="Collapsed">
            <Grid Margin="0,0,0,14">
              <WrapPanel x:Name="FilterPills" HorizontalAlignment="Left" />
              <Button x:Name="SortButton" Style="{StaticResource ChoicePill}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnSort" />
            </Grid>
            <StackPanel x:Name="SourceList" />
            <Button x:Name="ShowAllLink" Content="No other sources in this quality. Show all sources" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Visibility="Collapsed" Click="OnShowAll" />
          </StackPanel>

          <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="Collapsed">
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="{StaticResource Text3Brush}" HorizontalAlignment="Center" />
            <TextBlock Text="No sources found" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,6" />
            <TextBlock x:Name="EmptyText" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560" HorizontalAlignment="Center" />
            <Button x:Name="RetryButton" Content="Try again" Style="{StaticResource GhostButton}" Width="160" Margin="0,14,0,0" Click="OnRetry" />
          </StackPanel>

          <!-- which addons did not answer and which do not give streams, so a missing source is never a mystery -->
          <StackPanel x:Name="StatusLines" Margin="0,14,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
