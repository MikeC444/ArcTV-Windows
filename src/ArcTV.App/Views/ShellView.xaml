<UserControl x:Class="ArcTV.App.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{StaticResource BgBrush}">
    <ContentControl x:Name="Page" />

    <!-- the top bar floats over the page, with no shade behind it -->
    <Grid x:Name="Bar" VerticalAlignment="Top" Height="124">
      <Grid.Background><SolidColorBrush Color="Transparent" /></Grid.Background>
      <Grid x:Name="BarRow" Margin="28,18,28,0" VerticalAlignment="Top">
        <Grid.LayoutTransform><ScaleTransform x:Name="BarScale" ScaleX="1" ScaleY="1" /></Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image x:Name="Logo" Grid.Column="0" Source="/Assets/logo.png" Height="52" HorizontalAlignment="Left" Cursor="Hand" MouseLeftButtonDown="OnLogo" />
        <Border x:Name="PillsBox" Grid.Column="1" HorizontalAlignment="Center" Margin="24,0" CornerRadius="32" Background="#B3141417" BorderBrush="#17FFFFFF" BorderThickness="1" Padding="5">
          <StackPanel x:Name="Pills" Orientation="Horizontal" />
        </Border>
        <Button x:Name="AccountButton" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Height="58" FontSize="19" Padding="0" Click="OnAccount" ToolTip="Account">
          <Button.ContextMenu>
            <ContextMenu x:Name="AccountMenu" Style="{StaticResource DarkMenu}" />
          </Button.ContextMenu>
        </Button>
      </Grid>
    </Grid>

    <!-- the card menu (right-click on a poster) opens over everything -->
    <ContentControl x:Name="MenuLayer" />
  </Grid>
</UserControl>
