<UserControl x:Class="ArcTV.App.Views.BrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ArcTV.App.Views">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PosterTemplate.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- one line of posters; only the lines on screen exist, so only their pictures are fetched -->
      <DataTemplate DataType="{x:Type v:PosterRow}">
        <ItemsControl ItemsSource="{Binding Items}" Margin="44,0,0,0" Focusable="False" IsTabStop="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <StackPanel Orientation="Horizontal" Margin="44,96,44,12">
        <TextBlock x:Name="TitleText" FontSize="34" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="0,0,18,0" />
        <Button x:Name="GenreButton" Style="{StaticResource ChoicePill}" Click="OnGenreButton" />
        <Popup x:Name="GenrePopup" PlacementTarget="{Binding ElementName=GenreButton}" Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" Closed="OnGenreClosed" />
      </StackPanel>

      <StackPanel x:Name="SortPills" Orientation="Horizontal" Margin="44,0,44,12" Visibility="Collapsed" />

      <StackPanel x:Name="LoadingPanel" Margin="44,12,44,0" HorizontalAlignment="Left" Visibility="Collapsed">
        <TextBlock Text="Getting titles ready…" FontSize="16" Foreground="{StaticResource Text2Brush}" />
        <ProgressBar IsIndeterminate="True" Height="3" Width="220" Margin="0,14,0,0" HorizontalAlignment="Left" Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceBrush}" BorderThickness="0" />
      </StackPanel>

      <TextBlock x:Name="Message" Margin="44,12,44,0" FontSize="15" TextWrapping="Wrap" Foreground="{StaticResource Text2Brush}" Visibility="Collapsed" />
    </StackPanel>

    <ItemsControl x:Name="Rows" Grid.Row="1" Focusable="False" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" ScrollViewer.ScrollChanged="OnScrollChanged">
      <ItemsControl.Template>
        <ControlTemplate TargetType="ItemsControl">
          <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" CanContentScroll="True" Focusable="False" Padding="0,0,0,40">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </ItemsControl.Template>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
  </Grid>
</UserControl>
