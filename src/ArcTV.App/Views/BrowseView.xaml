<UserControl x:Class="ArcTV.App.Views.BrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ArcTV.App.Views"
             xmlns:c="clr-namespace:ArcTV.App.Controls">
  <Grid x:Name="Root">
    <!-- the heading is given to the poster list in code, as its first line, so the posters scroll all the way to the top of the window -->
    <v:PosterGrid x:Name="Posters" />
    <StackPanel x:Name="HeaderPanel">
      <StackPanel Orientation="Horizontal" Margin="24,124,24,12">
        <TextBlock x:Name="TitleText" FontSize="34" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="0,0,18,0" />
        <Button x:Name="GenreButton" Style="{StaticResource ChoicePill}" Click="OnGenreButton" />
        <Popup x:Name="GenrePopup" PlacementTarget="{Binding ElementName=GenreButton}" Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" Closed="OnGenreClosed" />
      </StackPanel>

      <StackPanel x:Name="SortPills" Orientation="Horizontal" Margin="24,0,24,12" Visibility="Collapsed" />

      <!-- grey posters while the first page loads; filled in code -->
      <ContentControl x:Name="LoadingPanel" IsHitTestVisible="False" />

      <TextBlock x:Name="Message" Margin="24,12,24,0" FontSize="15" TextWrapping="Wrap" Foreground="{StaticResource Text2Brush}" Visibility="Collapsed" />
  </StackPanel>

  </Grid>
</UserControl>
