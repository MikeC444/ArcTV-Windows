<UserControl x:Class="ArcTV.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ArcTV.App.Views">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Search" FontSize="34" FontWeight="ExtraBold" Margin="44,96,44,0" />

      <!-- the round search box -->
      <Grid Margin="44,20,44,12">
       <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*" MaxWidth="900" />
         <ColumnDefinition Width="Auto" />
       </Grid.ColumnDefinitions>
       <Border x:Name="BoxBorder" Height="56" CornerRadius="28" Background="{StaticResource SurfaceBrush}" BorderThickness="1" BorderBrush="#26FFFFFF">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" Margin="22,0,12,0" />
          <TextBlock Grid.Column="1" x:Name="Placeholder" Text="Search movies and TV shows" FontSize="18" Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center" IsHitTestVisible="False" />
          <TextBox Grid.Column="1" x:Name="Box" FontSize="18" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}" VerticalContentAlignment="Center" TextChanged="OnTextChanged" PreviewKeyDown="OnBoxKey" GotKeyboardFocus="OnBoxFocus" LostKeyboardFocus="OnBoxBlur" />
          <Button Grid.Column="2" x:Name="ClearButton" Width="30" Height="30" Margin="0,0,14,0" Cursor="Hand" ToolTip="Clear search" Visibility="Collapsed" Click="OnClear">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Grid Background="Transparent">
                  <Ellipse Fill="{StaticResource SurfaceHighBrush}" />
                  <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </Grid>
       </Border>
      </Grid>

      <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding ElementName=BoxBorder}" Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" Focusable="False">
        <Border x:Name="SuggestionBox" CornerRadius="16" Padding="8" Background="{StaticResource BgElevatedBrush}" BorderBrush="#26FFFFFF" BorderThickness="1" Margin="0,0,24,24">
          <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.6" /></Border.Effect>
          <StackPanel x:Name="Suggestions" />
        </Border>
      </Popup>

      <!-- before anything is searched: recent searches, and a hint -->
      <StackPanel x:Name="IdlePanel">
        <Grid x:Name="RecentPanel" Margin="44,8,44,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="900" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <TextBlock Text="Recent searches" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Content="Clear" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnClearRecents" />
            </Grid>
            <WrapPanel x:Name="Recents" />
          </StackPanel>
        </Grid>
        <TextBlock Text="Search for movies and TV shows across your installed addons." FontSize="14" Foreground="{StaticResource Text2Brush}" Margin="44,0" />
      </StackPanel>

      <StackPanel x:Name="SearchingPanel" Margin="44,16,44,0" HorizontalAlignment="Left" Visibility="Collapsed">
        <TextBlock Text="Searching your addons…" FontSize="16" Foreground="{StaticResource Text2Brush}" />
        <ProgressBar IsIndeterminate="True" Height="3" Width="220" Margin="0,14,0,0" HorizontalAlignment="Left" Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceBrush}" BorderThickness="0" />
      </StackPanel>

      <StackPanel x:Name="NonePanel" Margin="44,50,44,0" HorizontalAlignment="Center" Visibility="Collapsed">
        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="{StaticResource Text3Brush}" HorizontalAlignment="Center" />
        <TextBlock Text="No results" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,6" />
        <TextBlock x:Name="NoneText" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>

      <TextBlock x:Name="ErrorText" Margin="44,16,44,0" FontSize="15" TextWrapping="Wrap" Foreground="#FF8A80" Visibility="Collapsed" />

      <StackPanel x:Name="CheckingPanel" Orientation="Horizontal" Margin="44,0,44,0" Visibility="Collapsed">
        <ProgressBar IsIndeterminate="True" Height="3" Width="60" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceBrush}" BorderThickness="0" />
        <TextBlock Text="Still checking other addons…" FontSize="13" Foreground="{StaticResource Text2Brush}" />
      </StackPanel>
    </StackPanel>

    <v:PosterGrid x:Name="Posters" Grid.Row="1" Visibility="Hidden" />
  </Grid>
</UserControl>
