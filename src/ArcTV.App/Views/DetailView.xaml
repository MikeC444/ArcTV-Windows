<UserControl x:Class="ArcTV.App.Views.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ArcTV.App.Controls"
             xmlns:core="clr-namespace:ArcTV.Core.Details;assembly=ArcTV.Core">
  <UserControl.Resources>
   <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="PosterTemplate.xaml" />
    </ResourceDictionary.MergedDictionaries>

      <!-- a landscape card for a title (used by "You May Also Like"): its wide picture, then its name; it lifts a little under the pointer -->
      <DataTemplate x:Key="WideCard">
        <Button Style="{StaticResource PosterButton}">
          <StackPanel x:Name="Card" Width="300" Margin="0,10,16,10" Background="Transparent" RenderTransformOrigin="0.5,0.5" Cursor="Hand">
            <StackPanel.LayoutTransform><ScaleTransform ScaleX="{Binding Scale, Source={x:Static c:PosterMetrics.Instance}}" ScaleY="{Binding Scale, Source={x:Static c:PosterMetrics.Instance}}" /></StackPanel.LayoutTransform>
            <StackPanel.RenderTransform><ScaleTransform x:Name="Lift" ScaleX="1" ScaleY="1" /></StackPanel.RenderTransform>
            <c:RoundedBorder Width="300" Height="169" CornerRadius="16" Background="{StaticResource SurfaceBrush}" BorderBrush="#24FFFFFF" BorderThickness="1">
              <Grid>
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="12" Foreground="{StaticResource Text3Brush}" FontSize="13" />
                <c:RemoteImage Url="{Binding WidePicture}" DecodeWidth="640" Stretch="UniformToFill" />
                <!-- the title's logo over the picture's bottom-left corner, on a soft shade so it reads on any picture -->
                <Rectangle Height="80" VerticalAlignment="Bottom" IsHitTestVisible="False">
                  <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#00000000" Offset="0" />
                      <GradientStop Color="#B3000000" Offset="1" />
                    </LinearGradientBrush>
                  </Rectangle.Fill>
                </Rectangle>
                <c:RemoteImage Url="{Binding Logo}" DecodeWidth="320" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom" MaxWidth="140" MaxHeight="44" Margin="14,0,0,12" IsHitTestVisible="False" />
              </Grid>
            </c:RoundedBorder>
            <TextBlock Text="{Binding Name}" Margin="2,8,2,0" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
        <DataTemplate.Triggers>
          <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
            <Trigger.EnterActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </Trigger.EnterActions>
            <Trigger.ExitActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </Trigger.ExitActions>
          </Trigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    <!-- an episode: its picture with the number on it and a tick (green once watched, a bar for how far in), then its name and a couple of lines about it -->
    <DataTemplate DataType="{x:Type core:EpisodeEntry}">
      <Button Style="{StaticResource PosterButton}" Focusable="True">
      <StackPanel Width="280" Margin="0,6,16,6">
        <c:RoundedBorder Width="280" Height="158" CornerRadius="14" Background="{StaticResource SurfaceBrush}" BorderBrush="#24FFFFFF" BorderThickness="1">
          <Grid>
            <c:RemoteImage Url="{Binding Info.Thumbnail}" DecodeWidth="560" Stretch="UniformToFill" />
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,8,8,14" Padding="8,3" CornerRadius="6" Background="#B3000000">
              <TextBlock Text="{Binding Info.Episode, StringFormat=E{0}}" FontSize="12" FontWeight="Bold" />
            </Border>
            <ProgressBar Height="5" VerticalAlignment="Bottom" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" Background="#66000000" BorderThickness="0" IsHitTestVisible="False">
              <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers><DataTrigger Binding="{Binding InProgress}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
              </ProgressBar.Style>
            </ProgressBar>
            <!-- the tick: click it to mark the episode watched or not watched (its click is told apart from a click on the card by its Tag) -->
            <Button Tag="tick" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Cursor="Hand" Focusable="False" ToolTip="Mark as watched">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Disc" CornerRadius="15" Background="#99000000" BorderBrush="#66FFFFFF" BorderThickness="1">
                    <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding Watched}" Value="True">
                      <Setter TargetName="Disc" Property="Background" Value="#2ECC71" />
                      <Setter TargetName="Disc" Property="BorderBrush" Value="#2ECC71" />
                      <Setter TargetName="Mark" Property="Foreground" Value="Black" />
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="BorderBrush" Value="White" /></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </Grid>
        </c:RoundedBorder>
        <TextBlock Text="{Binding Info.DisplayTitle}" Margin="2,8,2,0" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Info.Overview}" Margin="2,2,2,0" FontSize="12" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" />
      </StackPanel>
      </Button>
    </DataTemplate>

    <!-- a person in the cast: round photo (or their initial), name, character -->
    <DataTemplate DataType="{x:Type core:CastMember}">
      <StackPanel Width="112" Margin="0,4,16,4">
        <c:RoundedBorder Width="96" Height="96" CornerRadius="48" Background="{StaticResource SurfaceHighBrush}" HorizontalAlignment="Center">
          <Grid>
            <TextBlock Text="{Binding Name[0]}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Text3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <c:RemoteImage Url="{Binding PhotoUrl}" DecodeWidth="220" Stretch="UniformToFill" />
          </Grid>
        </c:RoundedBorder>
        <TextBlock Text="{Binding Name}" Margin="0,8,0,0" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Role}" Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource Text2Brush}" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>
   </ResourceDictionary>
  </UserControl.Resources>

  <Grid Background="{StaticResource BgBrush}">
    <!-- the artwork fills the window; it is cropped to fit, never the other way round -->
    <Grid IsHitTestVisible="False" ClipToBounds="True">
      <c:RemoteImage x:Name="Backdrop" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Top" DecodeWidth="0" />
      <Rectangle>
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#8C08080A" Offset="0" />
            <GradientStop Color="#3308080A" Offset="0.55" />
            <GradientStop Color="#0008080A" Offset="1" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle>
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0008080A" Offset="0" />
            <GradientStop Color="#0008080A" Offset="0.4" />
            <GradientStop Color="#9408080A" Offset="0.75" />
            <GradientStop Color="#EB08080A" Offset="1" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
      <!-- as tall as the window at least, so "You May Also Like" sits at the bottom of the window on a short page and follows the content on a long one -->
      <Grid x:Name="PageBody" Margin="0,0,0,48">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
        <Button x:Name="BackButton" Content="&#x2039;  Back" Style="{StaticResource ChoicePill}" HorizontalAlignment="Left" Margin="24,132,0,0" Click="OnBack" />

        <!-- the title (or its logo), facts, genres and a few lines about it -->
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left" Margin="24,22,24,0">
          <Grid HorizontalAlignment="Left">
            <TextBlock x:Name="TitleText" FontSize="58" FontWeight="ExtraBold" TextWrapping="Wrap" MaxWidth="980">
              <TextBlock.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.6" /></TextBlock.Effect>
            </TextBlock>
            <c:RemoteImage x:Name="LogoImage" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxWidth="520" MaxHeight="145" DecodeWidth="1040" Shown="OnLogoShown" />
          </Grid>
          <TextBlock x:Name="FactsText" FontSize="21" FontWeight="Medium" Margin="0,18,0,0" />
          <TextBlock x:Name="GenresText" FontSize="17" FontWeight="Medium" Margin="0,8,0,0" />
          <TextBlock x:Name="DescriptionText" FontSize="20" TextWrapping="Wrap" MaxWidth="840" MaxHeight="130" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" Margin="0,18,0,0" />
        </StackPanel>

        <!-- the buttons, with the IMDb rating at the far end of the row -->
        <Grid Margin="24,28,24,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="PlayButton" Content="&#x25B6;  Play" Style="{StaticResource PrimaryButton}" Height="60" FontSize="18" Padding="34,0" IsEnabled="False" Margin="0,0,16,0" Click="OnPlay" />
            <Button x:Name="TrailerButton" Content="Trailer" Style="{StaticResource ChoicePill}" Height="60" FontSize="18" Margin="0,0,16,0" IsEnabled="False" ToolTip="Looking for a trailer…" Click="OnTrailer" />
            <Button x:Name="ListButton" Style="{StaticResource ChoicePill}" Height="60" FontSize="18" Margin="0,0,16,0" Click="OnList" />
            <Button x:Name="DownloadButton" Content="Download" Style="{StaticResource ChoicePill}" Height="60" FontSize="18" Margin="0,0,16,0" Click="OnDownload" />
            <Button x:Name="WatchedButton" Style="{StaticResource ChoicePill}" Height="60" FontSize="18" Margin="0,0,16,0" Click="OnWatched" />
            <Button x:Name="LikeButton" Style="{StaticResource ChoicePill}" Height="60" FontSize="18" MinWidth="80" Margin="0,0,16,0" Visibility="Collapsed" Click="OnLike" />
            <Button x:Name="DislikeButton" Style="{StaticResource ChoicePill}" Height="60" FontSize="18" MinWidth="80" Visibility="Collapsed" Click="OnDislike" />
          </StackPanel>
          <Border x:Name="RatingBox" HorizontalAlignment="Right" CornerRadius="12" Background="#73000000" Padding="18,8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <StackPanel>
                <TextBlock x:Name="RatingText" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="IMDb Rating" FontSize="11" Foreground="{StaticResource Text2Brush}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Height="3" Width="160" HorizontalAlignment="Left" Margin="24,22,0,0" Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceBrush}" BorderThickness="0" />

        <!-- a show's seasons and episodes -->
        <StackPanel x:Name="SeasonsPanel" Margin="0,34,0,0" Visibility="Collapsed">
          <TextBlock Text="Seasons" FontSize="30" FontWeight="Bold" Margin="24,0,24,14" />
          <c:ArrowScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SeasonButtons" Orientation="Horizontal" Margin="24,0" />
          </c:ArrowScrollViewer>
          <StackPanel Orientation="Horizontal" Margin="24,18,24,10">
            <TextBlock x:Name="SeasonTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Bottom" />
            <TextBlock x:Name="SeasonCount" FontSize="14" Foreground="{StaticResource Text3Brush}" VerticalAlignment="Bottom" Margin="12,0,0,1" />
            <Button x:Name="SeasonWatchedButton" Style="{StaticResource ChoicePill}" Margin="18,0,0,0" VerticalAlignment="Bottom" Click="OnSeasonWatched" />
          </StackPanel>
          <c:ArrowScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" ArrowCenter="85">
            <ItemsControl x:Name="EpisodeList" Margin="24,0,24,10">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </c:ArrowScrollViewer>
        </StackPanel>

        <!-- the cast -->
        <StackPanel x:Name="CastPanel" Margin="0,30,0,0" Visibility="Collapsed">
          <TextBlock Text="Cast" FontSize="30" FontWeight="Bold" Margin="24,0,24,12" />
          <c:ArrowScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" ArrowCenter="52">
            <ItemsControl x:Name="CastList" Margin="24,0,24,10">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </c:ArrowScrollViewer>
        </StackPanel>

        </StackPanel>

        <!-- a movie's page ends with other titles to try -->
        <StackPanel x:Name="SimilarPanel" Grid.Row="1" VerticalAlignment="Bottom" Margin="0,30,0,0" Visibility="Collapsed">
          <TextBlock Text="You May Also Like" FontSize="30" FontWeight="Bold" Margin="24,0,24,12" />
          <c:ArrowScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" ArrowCenter="95" ScalesWithPosters="True">
            <ItemsControl x:Name="SimilarList" ItemTemplate="{StaticResource WideCard}" Margin="24,0,24,10">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </c:ArrowScrollViewer>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
