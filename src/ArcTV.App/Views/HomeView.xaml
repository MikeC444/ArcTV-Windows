<UserControl x:Class="ArcTV.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ArcTV.App.Controls"
             xmlns:home="clr-namespace:ArcTV.Core.Home;assembly=ArcTV.Core"
             xmlns:addons="clr-namespace:ArcTV.Core.Addons;assembly=ArcTV.Core">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PosterTemplate.xaml" />
      </ResourceDictionary.MergedDictionaries>
    <DataTemplate DataType="{x:Type home:HomeSection}">
      <StackPanel Margin="0,0,0,16">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Margin="24,0,0,0" />
        <ItemsControl ItemsSource="{Binding Items}" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
              <c:ArrowScrollViewer CanContentScroll="True" Padding="24,0,0,0" ArrowCenter="154">
                <ItemsPresenter />
              </c:ArrowScrollViewer>
            </ControlTemplate>
          </ItemsControl.Template>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Visibility="Collapsed">
      <StackPanel>
        <Grid x:Name="HeroHost" />
        <ItemsControl x:Name="Rows" Margin="0,-60,0,8" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="Getting your rows ready…" FontSize="16" Foreground="{StaticResource Text2Brush}" />
      <ProgressBar IsIndeterminate="True" Height="3" Width="220" Margin="0,14,0,0" Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceBrush}" BorderThickness="0" />
    </StackPanel>

    <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="420">
      <TextBlock Text="Nothing to show yet" FontSize="26" FontWeight="ExtraBold" HorizontalAlignment="Center" />
      <TextBlock Text="Home couldn't load its rows. Check your connection and your addons, then try again." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Text2Brush}" Margin="0,10,0,18" />
      <Button Content="Try again" Style="{StaticResource GhostButton}" Width="160" Click="OnRetry" />
    </StackPanel>
  </Grid>
</UserControl>
