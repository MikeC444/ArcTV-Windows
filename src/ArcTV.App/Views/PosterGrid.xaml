<UserControl x:Class="ArcTV.App.Views.PosterGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ArcTV.App.Views"
             xmlns:c="clr-namespace:ArcTV.App.Controls">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PosterTemplate.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- one line of posters; only the lines on screen exist, so only their pictures are fetched. Spare width is shared out between the posters. -->
      <DataTemplate DataType="{x:Type v:PosterRow}">
        <ItemsControl ItemsSource="{Binding Items}" Margin="24,0,0,0" Focusable="False" IsTabStop="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><c:SpacedRowPanel Extra="{Binding Extra, RelativeSource={RelativeSource AncestorType={x:Type v:PosterGrid}}}" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </DataTemplate>

      <!-- a title over a group of lines, with a quieter note beside it ("12 results") -->
      <DataTemplate DataType="{x:Type v:SectionHeader}">
        <StackPanel Orientation="Horizontal" Margin="24,20,24,8">
          <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" VerticalAlignment="Bottom" />
          <TextBlock Text="{Binding Detail}" FontSize="14" Foreground="{StaticResource Text3Brush}" VerticalAlignment="Bottom" Margin="10,0,0,2" />
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <ItemsControl x:Name="Rows" Focusable="False" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1,1" VirtualizingPanel.CacheLengthUnit="Page" ScrollViewer.CanContentScroll="True" ScrollViewer.ScrollChanged="OnScrollChanged">
    <ItemsControl.Template>
      <ControlTemplate TargetType="ItemsControl">
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" CanContentScroll="True" Focusable="False" Padding="0,0,0,12">
          <ItemsPresenter />
        </ScrollViewer>
      </ControlTemplate>
    </ItemsControl.Template>
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
  </ItemsControl>
</UserControl>
